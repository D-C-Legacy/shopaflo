{
  "name": "shopaflo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write App.tsx index.ts src tests scripts",
    "format:check": "prettier --check App.tsx index.ts src tests scripts",
    "export": "expo export --platform all",
    "smoke": "node scripts/smoke.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~55.0.0",
    "expo-status-bar": "~55.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "^0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.2"
  }
}
